/delete-node/ &storage_partition;

/ {
	chosen {
		zephyr,settings-partition = &storage_partition;
	};
};

&code_partition {
	reg = <0x00202000 DT_SIZE_K(1992)>;
};

&flash0 {
	partitions {
		storage_partition: partition@3f4000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x003f4000 DT_SIZE_K(48)>;
		};
	};
};
