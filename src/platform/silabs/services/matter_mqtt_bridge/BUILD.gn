import("//build_overrides/chip.gni")

config("matter_mqtt_bridge_config") {
  include_dirs = [ "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/include" ]
  defines = [
    "SL_MATTER_ENABLE_MQTT_BRIDGE=1",
    "SL_MATTER_MQTT_BRIDGE_WILDCARD_SUBSCRIBE=1",
  ]
}

source_set("matter_mqtt_bridge") {
  sources = [
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/AttributeValueReader.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/CommandInjector.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/DeviceIdSource.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttAttributeListener.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttBridge.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttCodec.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttContract.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttTopic.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttValueConverter.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MqttClientTransportPort.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/adapters/ClusterAdapterRegistry.cpp",
  ]

  public_deps = [
    "${chip_root}/src/app/server",
    "${chip_root}/src/data-model-providers/codegen",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    app_data_model,
  ]

  public_configs = [ ":matter_mqtt_bridge_config" ]
}
