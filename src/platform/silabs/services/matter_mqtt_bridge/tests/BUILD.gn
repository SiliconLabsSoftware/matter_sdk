import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/pigweed.gni")
import("${chip_root}/build/chip/chip_test_suite.gni")

config("matter_mqtt_bridge_host_test_config") {
  defines = [
    "MATTER_MQTT_BRIDGE_HOST_TEST=1",
    "ZCL_USING_ON_OFF_CLUSTER_SERVER=1",
    "ZCL_USING_THERMOSTAT_CLUSTER_SERVER=1",
    "ZCL_USING_DOOR_LOCK_CLUSTER_SERVER=1",
    "ZCL_USING_WINDOW_COVERING_CLUSTER_SERVER=1",
  ]
}

chip_test_suite("matter_mqtt_bridge_tests") {
  output_name = "libMatterMqttBridgeTests"

  test_sources = [
    "TestMatterMqttArgsCodec.cpp",
    "TestMatterMqttCodec.cpp",
    "TestMatterMqttTopic.cpp",
  ]

  sources = [
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttCodec.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttContract.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/MatterMqttTopic.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/src/adapters/ClusterAdapterRegistry.cpp",
    "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/tests/TestClusterAdaptersRegistry.cpp",
    "${chip_root}/examples/thermostat/silabs/src/mqtt_bridge/DoorLockAdapter.cpp",
    "${chip_root}/examples/thermostat/silabs/src/mqtt_bridge/OnOffAdapter.cpp",
    "${chip_root}/examples/thermostat/silabs/src/mqtt_bridge/ThermostatAdapter.cpp",
    "${chip_root}/examples/thermostat/silabs/src/mqtt_bridge/WindowCoveringAdapter.cpp",
  ]

  public_deps = [
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/lib/support:testing",
    app_data_model,
  ]

  include_dirs = [ "${chip_root}/src/platform/silabs/services/matter_mqtt_bridge/include" ]

  public_configs = [ ":matter_mqtt_bridge_host_test_config" ]
}
